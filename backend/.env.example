# HirePilot backend — copy to `.env` in this directory.

# Server
PORT=4000
HOST=0.0.0.0

# Comma-separated browser origins for CORS (must include the Next.js dev origin)
CORS_ORIGINS=http://localhost:3000

# ── LLM provider ────────────────────────────────────────────────────────────
# Which provider to use for chat completions: openai | gemini | cerebras
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                 # leave blank to use api.openai.com

# Gemini
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# Cerebras
# CEREBRAS_API_KEY=
# CEREBRAS_CHAT_MODEL=llama-4-scout-17b-16e-instruct

# ── Embedding provider ───────────────────────────────────────────────────────
# Independent of LLM_PROVIDER — e.g. Cerebras for chat, OpenAI for embeddings.
# Options: openai | gemini | local
#   local  → all-MiniLM-L6-v2 (bundled with chromadb, no API key required)
#   openai → requires OPENAI_API_KEY
#   gemini → requires GEMINI_API_KEY
EMBEDDING_PROVIDER=local
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# HTTP server started via docker-compose (host port 8001 → container port 8000)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# asyncpg driver — backend running locally against Dockerised DB
DATABASE_URL=postgresql+asyncpg://hirepilot_user:hirepilot_pass@localhost:5432/hirepilot_db

# ── Google OAuth 2.0 (Gmail + Calendar) ─────────────────────────────────────
# 1. Download credentials.json from Google Cloud Console → APIs & Services → Credentials
# 2. Place it in this directory (backend/credentials.json)
# 3. Start the backend and visit GET /api/google/auth-url to authenticate
# Frontend URL used for scheduling links in emails
FRONTEND_URL=http://localhost:3000
