# HirePilot Backend & Frontend Configuration Template
# Copy this file to .env and fill in with your actual values

# --- Server ---
BACKEND_PORT=4000
FRONTEND_PORT=3000
HOST=0.0.0.0

# --- CORS Configuration ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database (Supabase PostgreSQL) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Supabase Configuration ---
SUPABASE_URL=https://[project].supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# --- LLM Provider Selection (openai | gemini | cerebras) ---
LLM_PROVIDER=openai

# --- OpenAI Configuration (Cerebras API - OpenAI compatible) ---
OPENAI_API_KEY=your_api_key_here
OPENAI_CHAT_MODEL=llama3.1-8b
OPENAI_BASE_URL=https://api.cerebras.ai/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Gemini Configuration (Optional) ---
GEMINI_API_KEY=your_gemini_key_here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Cerebras Configuration (Optional) ---
CEREBRAS_API_KEY=your_cerebras_key_here
CEREBRAS_CHAT_MODEL=llama3.1-8b

# --- Embedding Provider (local | openai | gemini) ---
EMBEDDING_PROVIDER=local

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# --- Chrome/Chromadb (for local development/testing) ---
# Note: ChromaDB is now containerized and accessible at http://chromadb:8000
CHROMA_HOST=chromadb
CHROMA_PORT=8000
